{
  "name": "@mussi/vitepress-theme",
  "version": "2.0.0",
  "description": "A lightweight VitePress theme extension for Ruby project documentation.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/vitepress/config/baseConfig.js"
  },
  "files": [
    "CHANGELOG.md",
    "screenshots",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElMassimo/vitepress-theme.git"
  },
  "keywords": [
    "vitepress",
    "vue",
    "documentation"
  ],
  "author": "Maximo Mussini",
  "license": "MIT",
  "homepage": "https://github.com/ElMassimo/vitepress-theme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "prettier --check \"src/**/*.{ts,js,css}\"",
    "lint:fix": "prettier --write \"src/**/*.{ts,js,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "pnpm lint && pnpm typecheck",
    "prepublishOnly": "pnpm test"
  },
  "peerDependencies": {
    "vitepress": "^2.0.0-alpha.20"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitepress": "^2.0.0-alpha.20"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.4.2"
}
